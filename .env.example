# Mockuuups Studio developer API key — https://mockuuups.studio/developers/
# 1Password: op://terminal access/mockuuuups api key/credential
MOCKUUUPS_API_KEY=

# Public base URL this server is reachable at. Required for image uploads:
# Mockuuups' renderer fetches the uploaded image back over the public internet,
# so this must resolve from outside the tailnet.
PUBLIC_BASE_URL=https://mockuuups.cdit-dev.de

# Max render size in px. The Trial plan is capped at 1000; anything higher
# needs the hi-res feature and fails with feature-not-available.
MOCKUUUPS_MAX_SIZE=1000

# Uploaded images are held in memory this long, then dropped.
UPLOAD_TTL_SECONDS=900

# Server transport: stdio (default) or http (streamable-http on /mcp)
TRANSPORT=stdio
HOST=127.0.0.1
PORT=8000

# Bearer token protecting the MCP endpoint — required when TRANSPORT=http
MCP_API_KEY=
